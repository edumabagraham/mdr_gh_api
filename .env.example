APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — verification and password reset codes go out through this.
#
# `log` does not send anything; it writes the whole message, code included, to
# storage/logs/laravel.log.
#
# For local development prefer a catcher, so the mail behaves like real mail
# without leaving the machine. Install one with `npm install -g maildev`, run
#
#     maildev --smtp 1025 --web 1080
#
# then set MAIL_MAILER=smtp, MAIL_SCHEME=smtp, MAIL_HOST=127.0.0.1 and
# MAIL_PORT=1025. Every code shows up at http://localhost:1080.
#
# Everywhere else, send through an authenticated provider (config/mail.php has
# postmark, resend, ses and mailgun wired up already) and never straight from
# the app server: unauthenticated mail from a random IP is junked on arrival.
#
# The provider is only half of the job. Without these three DNS records on the
# sending domain, Gmail and Outlook filter the mail however carefully it is
# written — this is the part that keeps codes out of spam:
#
#   SPF     TXT on the domain      v=spf1 include:<the provider's host> ~all
#   DKIM    the CNAME/TXT records the provider hands you — every one of them
#   DMARC   TXT on _dmarc          v=DMARC1; p=none; rua=mailto:you@yourdomain
#
# MAIL_FROM_ADDRESS has to sit on that same signed domain. A gmail.com or
# example.com sender fails DMARC alignment and lands in spam no matter what.
# Send yourself a test through mail-tester.com before trusting the setup.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
